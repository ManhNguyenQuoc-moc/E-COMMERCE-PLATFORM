{
  "testCaseId": "TC-PROD-007",
  "module": "Task 2 - Product Catalog",
  "title": "Admin partially updates product price via PATCH (Happy Case)",
  "type": "HAPPY",
  "preconditions": "TC-PROD-001 executed",
  "request": {
    "method": "PATCH",
    "url": "{{baseUrl}}/api/v1/products/{{productId}}",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer {{adminAccessToken}}"
    },
    "body": {
      "price": 320000
    }
  },
  "expected": {
    "statusCode": 204,
    "assertions": [
      "HTTP 204 No Content",
      "Subsequent GET /products/{{productId}} returns price == 320000"
    ]
  }
}
