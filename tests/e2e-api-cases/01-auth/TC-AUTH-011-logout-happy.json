{
  "testCaseId": "TC-AUTH-011",
  "module": "Task 1 - Authentication & RBAC",
  "title": "Logout and revoke own refresh token (Happy Case)",
  "type": "HAPPY",
  "preconditions": "TC-AUTH-008 executed",
  "request": {
    "method": "POST",
    "url": "{{baseUrl}}/api/v1/auth/logout",
    "headers": {
      "Content-Type": "application/json",
      "Authorization": "Bearer {{userAccessToken}}"
    },
    "body": {
      "refreshToken": "{{userRefreshToken}}"
    }
  },
  "expected": {
    "statusCode": 204,
    "assertions": [
      "HTTP 204 No Content"
    ]
  }
}
