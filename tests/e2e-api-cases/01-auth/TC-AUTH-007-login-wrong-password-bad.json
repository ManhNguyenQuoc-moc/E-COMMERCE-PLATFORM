{
  "testCaseId": "TC-AUTH-007",
  "module": "Task 1 - Authentication & RBAC",
  "title": "Login with wrong password (Bad Case)",
  "type": "BAD",
  "request": {
    "method": "POST",
    "url": "{{baseUrl}}/api/v1/auth/login",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "emailOrUsername": "e2e_customer_01",
      "password": "WrongPassword999"
    }
  },
  "expected": {
    "statusCode": 401,
    "assertions": [
      "ProblemDetails status == 401",
      "detail == 'Invalid email/username or password.'"
    ]
  }
}
