{
  "testCaseId": "TC-AUTH-004",
  "module": "Task 1 - Authentication & RBAC",
  "title": "Register with invalid password length (< 6 chars) (Bad Case)",
  "type": "BAD",
  "request": {
    "method": "POST",
    "url": "{{baseUrl}}/api/v1/auth/register",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "username": "e2e_short_pwd",
      "email": "short.pwd@example.com",
      "password": "123",
      "fullName": "Short Password"
    }
  },
  "expected": {
    "statusCode": 400,
    "assertions": [
      "ProblemDetails title == 'Validation Failed'",
      "errors.password contains 'at least 6 characters'"
    ]
  }
}
