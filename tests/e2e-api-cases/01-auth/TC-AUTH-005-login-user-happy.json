{
  "testCaseId": "TC-AUTH-005",
  "module": "Task 1 - Authentication & RBAC",
  "title": "Login with valid user credentials (Happy Case)",
  "type": "HAPPY",
  "preconditions": "TC-AUTH-001 executed",
  "request": {
    "method": "POST",
    "url": "{{baseUrl}}/api/v1/auth/login",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "emailOrUsername": "e2e_customer_01",
      "password": "Password@123"
    }
  },
  "expected": {
    "statusCode": 200,
    "assertions": [
      "accessToken and refreshToken are non-empty",
      "role == 'User'"
    ]
  },
  "saveVariables": {
    "userAccessToken": "$.accessToken",
    "userRefreshToken": "$.refreshToken"
  }
}
