# ==========================================
# Docker SQL Server Configuration
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=EcommercePlatformDb
DB_USER=sa
DB_SA_PASSWORD=YourStrong@Password123!

# ==========================================
# .NET EF Core Connection String
# ==========================================
ConnectionStrings__DefaultConnection="Server=127.0.0.1,1433;Database=EcommercePlatformDb;User Id=sa;Password=YourStrong@Password123!;TrustServerCertificate=True;Encrypt=False;"

# ==========================================
# JWT Authentication
# ==========================================
Jwt__Issuer=EcommercePlatform.Api
Jwt__Audience=EcommercePlatform.Client
Jwt__SecretKey=CHANGE_ME_TO_A_32_CHAR_MINIMUM_SECRET_KEY
Jwt__ExpiryMinutes=15
Jwt__RefreshTokenExpiryDays=7

